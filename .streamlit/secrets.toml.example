# Vorlage: nach .streamlit/secrets.toml kopieren (wird NICHT committet)
# bzw. auf Streamlit Community Cloud unter „Settings → Secrets“ einfügen.

# KI-Funktionen (Freitext, Foto, Wochenplan, Coach) – EINE der beiden Varianten:

# a) Google Gemini – mit kostenlosem Kontingent (Schlüssel: https://aistudio.google.com/apikey)
# GEMINI_API_KEY = "AIza..."
# GEMINI_MODEL = "gemini-flash-latest"      # optional

# b) Claude (Anthropic) – kostenpflichtig, Cent-Beträge
# ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-opus-5"         # optional, z. B. "claude-haiku-4-5" für sehr günstig

# Sind beide Schlüssel gesetzt, wird Claude genutzt – außer:
# AI_PROVIDER = "gemini"

# Optional: dauerhafte Datenbank (z. B. Supabase). Ohne Angabe: lokale SQLite-Datei data/kano.db
# DATABASE_URL = "postgresql+psycopg://postgres:PASSWORT@db.xxxx.supabase.co:5432/postgres"

# Optional: Kontakt für den User-Agent bei Open Food Facts (von OFF erbeten)
# OFF_CONTACT = "kano@example.com"
