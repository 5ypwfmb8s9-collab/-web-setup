# Vorlage fuer .streamlit/secrets.toml (lokal, NICHT einchecken!).
#
# Kopiere diese Datei zu ".streamlit/secrets.toml" und trage echte Werte ein.
# Diese Datei selbst bleibt eine Vorlage ohne echte Passwoerter/URLs und darf
# im (oeffentlichen) Repo bleiben.

# Login der Web-App (app.py). Fuer jeden Benutzer ein Eintrag
# Benutzername = "Passwort". Auf Streamlit Community Cloud unter
# App -> Settings -> Secrets im gleichen TOML-Format eintragen - dort
# landen die echten Passwoerter, nie im Git-Repo.
#
# WICHTIG: Die Schluessel in Anfuehrungszeichen setzen! Ein Punkt in
# einem unquoted TOML-Schluessel (okan.kocak = ...) erzeugt eine
# verschachtelte Tabelle statt eines Schluessels mit Punkt im Namen -
# der Login im Code sucht aber nach dem woertlichen Namen und findet
# ihn dann nicht.
[passwords]
"okan.kocak" = "hier-eigenes-passwort-eintragen"
"murat.kurt" = "hier-eigenes-passwort-eintragen"
"alperen.konar" = "hier-eigenes-passwort-eintragen"
"levin.akarcay" = "hier-eigenes-passwort-eintragen"
"feti.caliskan" = "hier-eigenes-passwort-eintragen"

# Nur fuer die alte Power-Automate-Variante von Reklamationen relevant
# (reklamation_logic.py, aktuell nicht in der App verdrahtet). Kopiere
# hierhin die beiden HTTP-URLs aus deinen Power-Automate-Flows (siehe
# REKLAMATIONEN_SETUP.md), falls du diese Variante wieder aktivierst.
[reklamationen]
list_url = "https://prod-00.westeurope.logic.azure.com:443/workflows/.../triggers/manual/paths/invoke?..."
update_url = "https://prod-00.westeurope.logic.azure.com:443/workflows/.../triggers/manual/paths/invoke?..."
