# Vorlage: nach .streamlit/secrets.toml kopieren (wird NICHT committet)
# bzw. auf Streamlit Community Cloud unter „Settings → Secrets“ einfügen.

# Pflicht für KI-Funktionen (Freitext, Foto, Wochenplan, Coach)
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: anderes Claude-Modell (Standard: claude-opus-5)
# ANTHROPIC_MODEL = "claude-opus-5"

# Optional: dauerhafte Datenbank (z. B. Supabase). Ohne Angabe: lokale SQLite-Datei data/kano.db
# DATABASE_URL = "postgresql+psycopg://postgres:PASSWORT@db.xxxx.supabase.co:5432/postgres"

# Optional: Kontakt für den User-Agent bei Open Food Facts (von OFF erbeten)
# OFF_CONTACT = "kano@example.com"
