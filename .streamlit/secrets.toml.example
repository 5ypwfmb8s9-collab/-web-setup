# Vorlage fuer .streamlit/secrets.toml (lokal, NICHT einchecken!).
#
# Kopiere diese Datei zu ".streamlit/secrets.toml" und trage dort die
# beiden HTTP-URLs aus deinen Power-Automate-Flows ein (siehe
# REKLAMATIONEN_SETUP.md, Schritt "Flow speichern und URL kopieren").
# Die URLs enthalten eine Signatur und wirken wie ein Passwort - nicht
# weitergeben, nicht in Git einchecken.

[reklamationen]
list_url = "https://prod-00.westeurope.logic.azure.com:443/workflows/.../triggers/manual/paths/invoke?..."
update_url = "https://prod-00.westeurope.logic.azure.com:443/workflows/.../triggers/manual/paths/invoke?..."
